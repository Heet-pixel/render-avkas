# ---- Amazon SES (use on Render) ----
MAIL_PROVIDER=ses
SES_REGION=ap-south-1
AWS_ACCESS_KEY_ID=AKIA................
AWS_SECRET_ACCESS_KEY=................................
# Must be a VERIFIED identity in SES (best: no-reply@yourdomain.com on a verified domain with DKIM)
SES_FROM_EMAIL=no-reply@avkasco.com
# Where enquiries arrive (comma separated). In SES sandbox each must be verified too.
SES_TO_EMAIL=avkasco@gmail.com
# Optional: separate inbox for job applications
SES_CAREER_TO_EMAIL=
NODE_ENV=production
